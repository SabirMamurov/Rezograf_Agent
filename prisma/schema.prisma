// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Template {
  id          String    @id @default(uuid())
  name        String
  widthMm     Int       @default(90)
  heightMm    Int       @default(70)
  htmlContent String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Append-only audit log of mutating actions. There's no user authentication
// in the app — operators open the LAN URL anonymously — so we identify "who
// did it" by the client's LAN IP plus User-Agent. Good enough granularity
// for the warehouse use case (figuring out which workstation made a wrong
// edit). Read via GET /api/activity-log; UI lives behind the hidden
// /changelog?activity=1 URL.
model ActivityLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  ip          String?
  userAgent   String?
  // High-level action type: "create" | "edit" | "delete" | "duplicate"
  // | "move" | "folder-delete". Free-form string instead of enum so we
  // don't need a schema migration to add a new action label later.
  action      String
  // What was acted on: "product" or "folder".
  targetType  String
  // For products: the Product.id. For folders: the relative folder path
  // ("Цех ПЦО\\Конфеты"). Nullable for actions where the target was
  // already deleted at log time (we still keep targetName in that case).
  targetId    String?
  // Human-readable label of the target — product name, folder path —
  // captured at action time so the log stays meaningful even if the
  // target is later renamed or deleted.
  targetName  String?
  // Optional one-line summary in operator-friendly Russian
  // (e.g. "Изменил название и состав").
  summary     String?
  // JSON dump of details: changed fields with before/after, folder
  // contents counts, etc. Stored as text because SQLite has no JSON
  // column type — read via JSON.parse on the way out.
  details     String?
}

model Product {
  id              String    @id @default(uuid())
  sku             String?
  sku2            String?
  name            String
  category        String?
  subcategory     String?
  composition     String?
  weight          String?
  nutritionalInfo String?
  storageCond     String?
  manufacturer    String?
  // Какой производитель печатается в блоке «Изготовитель» на этикетке.
  // null  → автоопределение по btwFilePath (ИП Абдуалиев по двум папкам,
  //         иначе Эко-фабрика). Сохраняет совместимость со старыми данными.
  // "abdualiev"  → принудительно ИП Абдуалиев В.Г.
  // "ekofabrika" → принудительно ООО «Эко-фабрика Сибирский Кедр».
  // Выставляется из редактора товара и переопределяет автоопределение.
  manufacturerType String?
  barcodeEan13    String?
  btwFilePath     String?
  certCode        String?
  quantity        String?
  boxWeight       String?
  sponsorText     String?
  // Free-form extra label text that doesn't fit the existing field schema —
  // seasonal markers ("Обечайка 8 Марта"), marketplace tags ("OZON",
  // "ВкусВилл"), BIO certs ("RU-BIO-112"), country-of-origin labels, brand
  // variants ("Брикет", "Шишка малая"), promo flags. Rendered on the label
  // between the title block and the quantity/weight block. Populated from
  // BarTender extractions (script: scripts/migrate_extra_text.js).
  extraText       String?
  // Export mark — when true, the renderer paints a large grey "Э" watermark
  // behind the whole label. Used by the warehouse to spot export-bound
  // products at a glance. In BarTender source files the "Э" lives as a
  // standalone text object (most often Текст 3). Populated from extractions
  // by scripts/migrate_export_mark.js — operators can also toggle it from
  // the /print inspector edit form.
  isExport        Boolean  @default(false)
  // ШК-label variant — when true, the renderer uses the stripped-down
  // "barcode-only" template and prints TWO stacked copies on a single
  // 70×90 mm sticker with a dashed cut-line at the midpoint. Operators
  // cut the sticker in half → two 70×45 mm labels per print. Saves the
  // thermal-printer tape on ВкусВилл / маркетплейс single-item ШК
  // labels. Also auto-triggered when btwFilePath sits under a folder
  // literally called «Единичный ШК» (legacy behavior since v1.3.2).
  isShkLabel      Boolean  @default(false)
  // Когда true — на этикетке отображается корпоративный логотип
  // «Сибирский Кедр» слева от блока «Изготовитель». На данный момент
  // лого подкрепляется к отдельным позициям (единичные случаи), поэтому
  // флаг по умолчанию false; оператор включает его per-product из
  // редактора. Работает одинаково для обоих юрлиц (Эко-фабрика и ИП
  // Абдуалиев) — текст изготовителя меняется по manufacturerType, лого
  // остаётся «Сибирский Кедр». На ШК-шаблоне (двойной штрихкод) лого
  // никогда не рендерится — отдельный layout, флаг там игнорируется.
  showCedarLogo   Boolean  @default(false)
  // Показывать ли строки «Дата изготовления» и «Годен до» на этикетке.
  //   null   → авто (по btwFilePath: если товар лежит в «весовой» папке
  //            /весов/i — даты скрываются; иначе — показываются).
  //   true   → всегда показать (переопределяет авто-режим).
  //   false  → всегда скрыть.
  // Введено под будущий «Честный знак» (Data Matrix + дата), для которого
  // нужно освободить нижнюю часть этикетки на весовых товарах. Отдельные
  // позиции («Югорские традиции шишка/земляника 90х70») сохраняют даты
  // через явный true.
  showLabelDates  Boolean?

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
